# EFM firmware - clang-tidy. Nguon dang tin cay nhat: canh bao hien truc tiep trong VS Code qua clangd
# (dung clangd cua esp-clang, xem README.md "clangd dung nham ban"). `idf.py clang-check` cung chay duoc
# nhung DA KIEM CHUNG la khong doc dung Checks:/HeaderFilterRegex o day (pyclang tu dung danh sach rieng)
# va thieu buoc loc co bien dich cho ca 2 kien truc -> tren project that co the 18/19 file bao "file not
# found"/"unknown argument" thay vi phan tich duoc - xem README.md, muc "Cong cu", doan "Da kiem chung
# that - han che cua idf.py clang-check" truoc khi tin warnings.txt.
# Nhom check chon cho C embedded: bat loi thuc su (bugprone/cert/analyzer), khong bat style
# da do clang-format lo.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-assignment-in-if-condition,
  cert-*,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  concurrency-*,
  misc-*,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-unused-parameters,
  -misc-header-include-cycle,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-braces-around-statements,
  readability-else-after-return,
  readability-function-cognitive-complexity,
  readability-function-size,
  readability-identifier-naming,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-non-const-parameter,
  readability-redundant-declaration,
  readability-duplicate-include
WarningsAsErrors: 'clang-analyzer-*,bugprone-use-after-move,cert-err33-c'
# Chi bao loi trong code du an, khong bao trong header ESP-IDF
HeaderFilterRegex: '.*/(main|components)/.*'
# ESP-IDF cung co thu muc components/ -> phai loai tru tuong minh (can clang-tidy >= 19)
ExcludeHeaderFilterRegex: '.*/(esp-idf|\.espressif|managed_components|build)/.*'
CheckOptions:
  - { key: readability-function-cognitive-complexity.Threshold, value: '25' }
  - { key: readability-function-cognitive-complexity.IgnoreMacros, value: true }
  - { key: readability-function-size.LineThreshold, value: '120' }
  - { key: readability-function-size.ParameterThreshold, value: '6' }
  - { key: readability-identifier-naming.FunctionCase, value: lower_case }
  - { key: readability-identifier-naming.VariableCase, value: lower_case }
  - { key: readability-identifier-naming.ParameterCase, value: lower_case }
  - { key: readability-identifier-naming.TypedefCase, value: lower_case }
  - { key: readability-identifier-naming.TypedefSuffix, value: '_t' }
  - { key: readability-identifier-naming.EnumConstantCase, value: UPPER_CASE }
  - { key: readability-identifier-naming.MacroDefinitionCase, value: UPPER_CASE }
  - { key: readability-identifier-naming.GlobalConstantCase, value: lower_case }
  - { key: readability-identifier-naming.VariableIgnoredRegexp, value: '^TAG$' }
  - { key: bugprone-unused-return-value.CheckedReturnTypes, value: 'esp_err_t' }
