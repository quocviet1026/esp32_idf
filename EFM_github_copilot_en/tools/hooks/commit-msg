#!/bin/sh
# commit-msg hook - checks the commit message against .github/instructions/commit.instructions.md
# Usage: run automatically by git (installed via tools/install-hooks.sh), or manually/in CI:
#   tools/hooks/commit-msg <path-to-message-file>
# POSIX sh, no dependency beyond grep/sed/awk.

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    echo "commit-msg: missing message file" >&2
    exit 2
fi

TYPES="feat|fix|perf|refactor|sec|test|docs|build|ci|style|chore|revert"
SCOPES="main|transport|mqtt|wifi|lorawan|rak3172|ota|config|cli|display|ui|button|sensor|storage|health|bsp|partition|deps"
SCOPE_OPTIONAL_TYPES="docs|ci|chore|style|revert"
TESTED_REQUIRED_TYPES="feat|fix|perf|sec"
MAX_LEN=72

# Strip the part after the scissors line (git commit -v), comment lines (#), and trailing blank
# lines, the same way git itself cleans up the message
CLEAN=$(sed -e '/^# -* >8 -*$/,$d' -e '/^#/d' "$MSG_FILE" | awk 'NF {found=1} found' | sed -e ':a' -e '/^\n*$/{$d;N;ba' -e '}')
HEADER=$(printf '%s\n' "$CLEAN" | sed -n '1p')

# Allow messages generated by git itself
case "$HEADER" in
    "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

ERR=0
fail() {
    echo "commit-msg: $1" >&2
    ERR=1
}

if [ -z "$HEADER" ]; then
    fail "empty message"
    exit 1
fi

# --- Header ---
HLEN=$(printf '%s' "$HEADER" | wc -m | tr -d ' ')
[ "$HLEN" -le "$MAX_LEN" ] || fail "header is $HLEN characters long (max $MAX_LEN)"

if ! printf '%s' "$HEADER" | grep -Eq "^($TYPES)(\([a-z0-9_-]+(,[a-z0-9_-]+)?\))?!?: [^ ].*$"; then
    fail "header has the wrong format. Use: <type>(<scope>): <subject>
       type : ${TYPES}
       example: feat(lorawan): add confirmed uplink with bounded retry"
else
    TYPE=$(printf '%s' "$HEADER" | sed -E 's/^([a-z]+).*/\1/')
    SCOPE=$(printf '%s' "$HEADER" | sed -nE 's/^[a-z]+\(([^)]*)\).*/\1/p')
    SUBJECT=$(printf '%s' "$HEADER" | sed -E 's/^[^:]*: //')

    if [ -z "$SCOPE" ]; then
        printf '%s' "$TYPE" | grep -Eq "^($SCOPE_OPTIONAL_TYPES)$" || fail "type '$TYPE' requires a scope"
    else
        for s in $(printf '%s' "$SCOPE" | tr ',' ' '); do
            printf '%s' "$s" | grep -Eq "^($SCOPES)$" || fail "scope '$s' is not valid. Valid scopes: $SCOPES"
        done
    fi

    case "$SUBJECT" in
        *.) fail "subject must not end with a period" ;;
    esac
    printf '%s' "$SUBJECT" | grep -Eq '^[A-Z][a-z]' && fail "subject must start with a lowercase letter (e.g. 'add ...', not 'Add ...')"
    printf '%s' "$SUBJECT" | grep -Eiq '^(added|adds|fixed|fixes|updated|updates|removed|removes|changed|changes) ' &&
        fail "subject must use the imperative mood (add/fix/update...), not past tense/third person"
fi

# --- Line 2 must be blank ---
LINE2=$(printf '%s\n' "$CLEAN" | sed -n '2p')
[ -z "$LINE2" ] || fail "line 2 must be blank (separates header from body)"

# --- Body: every line <= MAX_LEN (except lines containing a URL) ---
printf '%s\n' "$CLEAN" | sed -n '3,$p' | awk -v max="$MAX_LEN" '
    /https?:\/\// { next }
    { n = length($0); if (n > max) { printf "commit-msg: body line %d is %d characters long (max %d)\n", NR + 2, n, max; bad = 1 } }
    END { exit bad }' >&2 || ERR=1

# --- Tested: footer required for feat/fix/perf/sec ---
if [ -n "${TYPE:-}" ] && printf '%s' "$TYPE" | grep -Eq "^($TESTED_REQUIRED_TYPES)$"; then
    printf '%s\n' "$CLEAN" | grep -Eq '^Tested: (hw|bench|build|none) - .+' ||
        fail "type '$TYPE' requires a 'Tested: <hw|bench|build|none> - <description>' footer"
fi

# --- '!' must come with a BREAKING CHANGE footer ---
if printf '%s' "$HEADER" | grep -Eq '^[a-z]+(\([^)]*\))?!:'; then
    printf '%s\n' "$CLEAN" | grep -Eq '^BREAKING CHANGE: .+' || fail "a '!' in the header requires a 'BREAKING CHANGE: ...' footer"
fi

if [ "$ERR" -ne 0 ]; then
    echo "commit-msg: see .github/instructions/commit.instructions.md" >&2
    exit 1
fi
exit 0
